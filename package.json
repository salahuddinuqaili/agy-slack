{
  "name": "agy-slack",
  "version": "1.2.0",
  "description": "Slack MCP for Google Antigravity CLI and Gemini CLI v0.59. Install as a Gemini extension, names not IDs, confirm before send.",
  "type": "module",
  "license": "MIT",
  "author": "Salahuddin Uqaili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salahuddinuqaili/agy-slack.git"
  },
  "bugs": {
    "url": "https://github.com/salahuddinuqaili/agy-slack/issues"
  },
  "homepage": "https://github.com/salahuddinuqaili/agy-slack#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "slack",
    "antigravity",
    "agy",
    "cli",
    "ai-agent",
    "google-antigravity",
    "google-gemini-cli"
  ],
  "bin": {
    "agy-slack": "./dist/index.js",
    "agy-slack-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "GEMINI.md",
    "gemini-extension.json",
    "commands",
    "skills",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "demo": "node dist/index.js serve --demo",
    "test": "tsx --test src/core/*.test.ts src/install.test.ts",
    "test:crowd": "tsx --test src/core/crowd.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
