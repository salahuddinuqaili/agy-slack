# Bot token (xoxb-...) — posting as the app, public channels the bot is in.
SLACK_BOT_TOKEN=

# User token (xoxp-...) — search, DMs, acting as you. Strongly recommended.
SLACK_USER_TOKEN=

# Optional alias if you only have one token.
# SLACK_TOKEN=

# readonly | confirm | write   (default: confirm)
SLACK_MCP_MODE=confirm

# Optional comma-separated allow/deny lists (#eng, C123, @maya)
# SLACK_MCP_ALLOW_CHANNELS=
# SLACK_MCP_DENY_CHANNELS=

# Compact markdown (default) or json
# SLACK_MCP_OUTPUT=markdown

# IANA timezone for "today" / "yesterday"
# SLACK_MCP_TZ=Europe/Berlin

# Demo workspace, no Slack credentials required
# SLACK_MCP_DEMO=1
