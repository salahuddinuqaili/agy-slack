{
  "mcpServers": {
    "agy-slack": {
      "command": "npx",
      "args": ["-y", "github:salahuddinuqaili/agy-slack"],
      "env": {
        "SLACK_USER_TOKEN": "xoxp-your-user-token",
        "SLACK_BOT_TOKEN": "xoxb-optional-bot-token",
        "SLACK_MCP_MODE": "confirm",
        "SLACK_MCP_TZ": "Europe/Berlin"
      }
    }
  }
}
